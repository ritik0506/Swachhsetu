# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/swachhsetu

# Security (REQUIRED - no defaults in production)
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Redis Configuration (for BullMQ job queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Ollama AI Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_PRIMARY_MODEL=llama3:8b
OLLAMA_SECONDARY_MODEL=mistral:7b
OLLAMA_VISION_MODEL=llava:13b
OLLAMA_TIMEOUT=120000
OLLAMA_MAX_RETRIES=3

# AI Feature Flags (true/false)
ENABLE_AI_TRIAGE=false
ENABLE_AI_ASSIGNMENT=false
ENABLE_AI_TRANSLATION=false
ENABLE_AI_FOLLOWUP=false
ENABLE_AI_VISION=false
ENABLE_FORENSIC_ANALYSIS=false
ENABLE_GEOSPATIAL_VERIFICATION=false
ENABLE_LINGUISTIC_ANALYSIS=false
ENABLE_DEDUPLICATION=false

# AI Configuration Thresholds
AI_CONFIDENCE_THRESHOLD=0.7
AI_AUTO_ASSIGN_THRESHOLD=0.85
MAX_TRANSLATION_LENGTH=5000

# Deduplication Configuration
DUPLICATE_RADIUS_METERS=20
DUPLICATE_CONFIDENCE_THRESHOLD=0.90
DUPLICATE_TIME_WINDOW_HOURS=72

# Logging
LOG_LEVEL=debug

# Initial Admin Setup (only for scripts/createAdmin.js)
INITIAL_ADMIN_PASSWORD=
INITIAL_MODERATOR_PASSWORD=

# Notification Providers (console/twilio/sendgrid)
SMS_PROVIDER=console
EMAIL_PROVIDER=console

# Twilio SMS Configuration (optional)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# SendGrid Email Configuration (optional)
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=

